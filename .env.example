# Groq API key used for the classify and step-answer-parsing LLM calls.
GROQ_API_KEY=

# Model for those calls. Groq's lineup changes often -- check
# https://console.groq.com/docs/models for what's currently available if
# this one 404s. gpt-oss-120b has solid tool-calling support (needed for
# structured output) and Groq's free tier is enough for this project's
# call volume.
BELLA_AGENT_MODEL=openai/gpt-oss-120b

# Where conversation state (and any pending review) is persisted.
# Defaults to data/conversations.sqlite (gitignored) if unset -- override
# for a real deployment (e.g. a mounted volume path).
# BELLA_AGENT_DB_PATH=data/conversations.sqlite

# Bank/PayPal details for the final-confirmation reply. Only needed here
# for local dev if you want to test the env-var path specifically --
# normally local dev just uses config/payment_secrets.json instead (see
# config/payment_secrets.example.json), and a real deployment sets these
# in the hosting platform's own secrets panel. Any of these being set
# takes priority over the file -- see payment.py.
# PAYMENT_BANK_NAME=
# PAYMENT_ACCOUNT_NAME=
# PAYMENT_SORT_CODE=
# PAYMENT_ACCOUNT_NUMBER=
# PAYMENT_IBAN=
# PAYMENT_PAYPAL=

# Required -- web.py (the review dashboard + webhook app) refuses to
# start without both of these set. The dashboard carries bank details
# and customer messages, so it's gated behind HTTP Basic Auth; pick
# anything for local dev, but use a real, unique password for a
# deployment reachable from the internet.
DASHBOARD_USERNAME=owner
DASHBOARD_PASSWORD=change-me

# Optional -- when set, unhandled errors while processing a customer
# message (e.g. Groq being down) are reported to this Sentry project
# instead of just sitting in the log stream unnoticed. Leave unset for
# local dev; set it on a real deployment. Get a DSN from sentry.io
# (free tier is plenty for this project's volume).
# SENTRY_DSN=

# Optional -- real Instagram integration. All three unset means
# /webhook still works with the simulated payload (local dev/tests),
# and _deliver_to_customer just logs instead of actually sending. Set
# all three together for a real deployment; see the Meta app's
# dashboard (API setup with Instagram login):
#   META_ACCESS_TOKEN  -- "Generate token" next to the connected
#                          Instagram account, under "2. Generate access
#                          tokens".
#   META_IG_USER_ID    -- the numeric ID shown under that same account
#                          (e.g. next to its username) -- the <IG_ID>
#                          the Send API posts to.
#   META_VERIFY_TOKEN  -- a secret *you* make up (not something Meta
#                          gives you), entered in both this env var and
#                          the "Verify token" field when saving the
#                          webhook's Callback URL -- GET /webhook checks
#                          the two match before echoing hub.challenge.
# META_ACCESS_TOKEN=
# META_IG_USER_ID=
# META_VERIFY_TOKEN=
